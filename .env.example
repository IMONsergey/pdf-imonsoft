# Copy to .env. Never commit .env or user documents.
# Loopback by default: this build is for an internal workspace.
PORT=8080
BIND_ADDRESS=127.0.0.1
MAX_UPLOAD_MB=50
# Includes multipart overhead. Keep higher than MAX_UPLOAD_MB.
MAX_REQUEST_MB=52
MAX_PAGES=200
RETENTION_SECONDS=3600
JOB_TIMEOUT_SECONDS=180
WORKER_CONCURRENCY=1
WORKER_MEMORY_MB=1024
# Set true behind an HTTPS reverse proxy. False is needed for localhost HTTP.
COOKIE_SECURE=false
# Optional, at least 32 random characters. Empty generates a private key in data volume.
SESSION_SECRET=
